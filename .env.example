# Your LangWatch org API key (Settings > API keys). Used by provisioning and
# the reconciliation loop. Never used on the request path.
LANGWATCH_API_KEY=

# The project virtual keys and budgets live under (provisioning REST is
# project-scoped; the key authorizes, this header targets).
LANGWATCH_PROJECT_ID=

# The LangWatch app (REST APIs live here).
LANGWATCH_BASE_URL=http://localhost:5560

# The AI gateway (the OpenAI-compatible endpoint your app talks to).
LANGWATCH_GATEWAY_URL=http://localhost:6560

# Where the demo app itself runs.
APP_PORT=4100

# Webhook receivers. Register these URLs as webhook endpoints (the provision
# script does it for you) and paste each endpoint's signing secret here.
TS_RECEIVER_PORT=4101
TS_WEBHOOK_SECRET=
PY_RECEIVER_PORT=4102
PY_WEBHOOK_SECRET=
