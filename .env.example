# Your LangWatch org API key (Settings > API keys). Used by provisioning,
# cap reads and the reconciliation loop. Never used on the request path.
LANGWATCH_API_KEY=

# The project virtual keys and budgets live under (provisioning REST is
# project-scoped; the key authorizes, this header targets).
LANGWATCH_PROJECT_ID=

# How a signup provisions a customer. `virtual_key` mints one virtual key per
# customer under the project above. `project` gives every customer a LangWatch
# project of its own and scopes its key, caps and traces to it.
LANGWATCH_PROVISION_MODE=virtual_key

# The team every customer project is created under, in `project` mode. Run
# `pnpm setup:team` once and it creates the team and fills this in.
LANGWATCH_TEAM_ID=

# The LangWatch app (REST APIs live here).
LANGWATCH_BASE_URL=http://localhost:5560

# The AI gateway (the OpenAI-compatible endpoint your app talks to).
LANGWATCH_GATEWAY_URL=http://localhost:5563

# Where the demo app itself runs. APP_PUBLIC_URL is the address LangWatch
# has to reach for webhooks; point it at your tunnel when the app is not on
# the same host as LangWatch.
APP_PORT=4100
APP_PUBLIC_URL=http://localhost:4100

# The signing secret for this shell's own webhook endpoint. `pnpm
# setup:webhook` registers <APP_PUBLIC_URL>/webhooks/langwatch, and the python
# shell's endpoint in the same run, and writes each secret to its own key.
APP_WEBHOOK_SECRET=

# The secret a roll just replaced. It stays valid for a day, and deliveries in
# flight are signed with both, so the receiver verifies against either and the
# swap costs nothing. `pnpm setup:webhook` fills this in when it rolls.
APP_WEBHOOK_SECRET_PREVIOUS=

# The standalone receivers, one per language. Register these URLs as their
# own webhook endpoints (the provision scripts do it for you) and paste
# each endpoint's signing secret here.
TS_RECEIVER_PORT=4101
TS_WEBHOOK_SECRET=
TS_WEBHOOK_SECRET_PREVIOUS=
PY_RECEIVER_PORT=4102
PY_WEBHOOK_SECRET=
PY_WEBHOOK_SECRET_PREVIOUS=

# The python app shell, which hosts its own receiver route. Its endpoint is
# registered by `pnpm setup:webhook` alongside the TypeScript shell's, which
# writes the two keys below. Set APP_PY_PUBLIC_URL when this shell is not on
# the same host as LangWatch; without it the endpoint is localhost:APP_PY_PORT.
APP_PY_PORT=4200
PY_APP_WEBHOOK_SECRET=
PY_APP_WEBHOOK_SECRET_PREVIOUS=
