{
  "name": "@acme/app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The ACME Agents app shell: customers sign up, create agents, chat; LangWatch meters every call",
  "scripts": {
    "dev": "tsx watch src/server.ts",
